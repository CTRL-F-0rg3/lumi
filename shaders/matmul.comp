#version 450

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) buffer InputA { float a[]; };
layout(binding = 1) buffer InputB { float b[]; };
layout(binding = 2) buffer Output { float out_c[]; };

layout(push_constant) uniform PushConsts {
    uint dim;
} pc;

void main() {
    uint row = gl_GlobalInvocationID.y;
    uint col = gl_GlobalInvocationID.x;
    
    if (row < pc.dim && col < pc.dim) {
        float sum = 0.0;
        for (uint k = 0; k < pc.dim; k++) {
            sum += a[row * pc.dim + k] * b[k * pc.dim + col];
        }
        out_c[row * pc.dim + col] = sum;
    }
}
